# Chép file này thành .env rồi điền giá trị. KHÔNG commit .env.

# Binary ReiCut/Concat dùng cho headless MCP
CONCAT_BIN=D:\work\reicut\src\target\app\concat.exe
# Thư mục ngoài home mà headless được phép ghi (Windows ngăn cách bằng ;)
CONCAT_MCP_ROOTS=D:\work\autoclip\data

# LLM (P3) — LLM_PROVIDER=none sẽ chạy fallback không-LLM
# none | openai | anthropic | openai_compat (router riêng kiểu OpenAI, ví dụ 9router)
LLM_PROVIDER=none
# openai_compat: URL gốc kèm /v1, key của router, tên model đúng như /v1/models liệt kê
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Planner cần model trả JSON gọn. Thử trên 9router (2026-10): oc/deepseek-v4.1-flash-free
# suy luận >14k token rồi trả rỗng (không dùng được); oc/mimo-v2.6-flash-free chạy đúng
# nhưng ~2 phút/lần gọi -> đặt LLM_TIMEOUT_SEC=300.
LLM_TIMEOUT_SEC=60
# Model nhận ảnh cho vision tagging/QA; để trống = tắt vision (dùng heuristic)
VISION_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Thư mục db, cache, output
DATA_DIR=D:\work\autoclip\data
